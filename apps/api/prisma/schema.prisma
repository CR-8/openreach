datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  ADMIN
  AGENT
}

enum WhatsappSessionStatus {
  DISCONNECTED
  STARTING
  SCAN_QR_CODE
  CONNECTED
  PAUSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  LOCATION
}

enum CampaignType {
  BROADCAST
  DRIP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Organization {
  id               String            @id @default(uuid())
  name             String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  memberships      Membership[]
  whatsappSessions WhatsappSession[]
  contacts         Contact[]
  conversations    Conversation[]
  aiProviders      AiProvider[]
  prompts          Prompt[]
  agents           Agent[]
  knowledgeBases   KnowledgeBase[]
  workflows        Workflow[]
  campaigns        Campaign[]
  auditLogs        AuditLog[]
  apiKeys          ApiKey[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           Role         @default(AGENT)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  memberships    Membership[]
  assignedTo     Conversation[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Membership {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           Role         @default(AGENT)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("memberships")
}

model WhatsappSession {
  id             String                @id @default(uuid())
  organizationId String
  sessionId      String                @unique
  provider       String                @default("wppconnect")
  status         WhatsappSessionStatus @default(DISCONNECTED)
  phoneNumber    String?
  qrCodeUrl      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       Contact[]

  @@map("whatsapp_sessions")
}

model Contact {
  id             String               @id @default(uuid())
  organizationId String
  sessionId      String
  phone          String
  name           String?
  tags           String[]             @default([])
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session        WhatsappSession      @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  conversations  Conversation[]
  recipients     CampaignRecipient[]

  @@unique([organizationId, phone])
  @@map("contacts")
}

model Conversation {
  id             String         @id @default(uuid())
  organizationId String
  contactId      String
  status         String         @default("OPEN") // OPEN, CLOSED, RESOLVED
  assignedUserId String?
  aiEnabled      Boolean        @default(true)
  lastMessageAt  DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser   User?          @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  content        String
  mediaUrl       String?
  aiGenerated    Boolean          @default(false)
  metadata       Json?
  createdAt      DateTime         @default(now())

  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model AiProvider {
  id               String       @id @default(uuid())
  organizationId   String
  name             String
  baseUrl          String
  apiKeyEncrypted  String
  defaultModel     String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prompts          Prompt[]

  @@map("ai_providers")
}

model Prompt {
  id             String       @id @default(uuid())
  organizationId String
  aiProviderId   String?
  name           String
  systemPrompt   String
  variables      String[]     @default([])
  temperature    Float        @default(0.7)
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aiProvider     AiProvider?  @relation(fields: [aiProviderId], references: [id], onDelete: SetNull)
  agents         Agent[]

  @@map("prompts")
}

model Agent {
  id              String         @id @default(uuid())
  organizationId  String
  name            String
  promptId        String?
  knowledgeBaseId String?
  greeting        String?
  businessHours   Json?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prompt          Prompt?        @relation(fields: [promptId], references: [id], onDelete: SetNull)
  knowledgeBase   KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)

  @@map("agents")
}

model KnowledgeBase {
  id             String              @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      KnowledgeDocument[]
  agents         Agent[]

  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id              String           @id @default(uuid())
  knowledgeBaseId String
  filename        String
  mimetype        String
  status          String           @default("READY")
  createdAt       DateTime         @default(now())

  knowledgeBase   KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks          KnowledgeChunk[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String            @id @default(uuid())
  documentId String
  content    String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime          @default(now())

  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("knowledge_chunks")
}

model Workflow {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  nodes          Json
  edges          Json
  isActive       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs           WorkflowRun[]

  @@map("workflows")
}

model WorkflowRun {
  id         String            @id @default(uuid())
  workflowId String
  status     WorkflowRunStatus @default(PENDING)
  logs       Json?
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
  error      String?

  workflow   Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_runs")
}

model Campaign {
  id             String              @id @default(uuid())
  organizationId String
  name           String
  type           CampaignType        @default(BROADCAST)
  status         CampaignStatus      @default(DRAFT)
  schedule       DateTime?
  template       String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipients     CampaignRecipient[]

  @@map("campaigns")
}

model CampaignRecipient {
  id         String    @id @default(uuid())
  campaignId String
  contactId  String
  status     String    @default("PENDING")
  sentAt     DateTime?

  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("campaign_recipients")
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  key            String       @unique
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
