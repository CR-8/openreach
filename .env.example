# Database & Redis
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openreach?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="super-secret-openreach-jwt-token-key-change-in-prod"
JWT_REFRESH_SECRET="super-secret-openreach-refresh-token-key-change-in-prod"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# API & Web
PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# WPPConnect Server
WPPCONNECT_URL="http://localhost:21465"
WPPCONNECT_SECRET_KEY="THISISMYSECURETOKEN"

# LiteLLM AI Proxy
LITELLM_URL="http://localhost:4000/v1"
LITELLM_MASTER_KEY="sk-litellm-master-key"

# MinIO Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="openreach-media"
